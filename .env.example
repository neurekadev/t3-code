# T3 Code in Docker: settings
#
# Copy this file to .env and change what you need:   cp .env.example .env
# Lines starting with # are notes or optional settings. To turn an optional
# setting on, remove the # in front of it.
# After editing .env, apply the change with:          docker compose up -d


# --[ CONNECTION ]-------------------------------------------------------------

# REQUIRED. Which of the server's network addresses T3 Code (port 3773) and
# the web preview ports are reachable on. Your desktop and mobile apps connect
# here. T3 Code will not start until you fill in one of these:
#   0.0.0.0        every network the server is on. Simplest, but Docker opens
#                  these ports past the server's firewall (ufw/firewalld), so
#                  use it only when the server is not directly reachable from
#                  the internet, e.g. behind your home router.
#   100.x.y.z      only your Tailscale network: the server's Tailscale IP
#   192.168.x.y    only your home network: the server's LAN IP
# A Tailscale or LAN IP needs a one-time server setting so T3 Code comes back
# after a reboot: see "Limit access to one network" in the README.
T3CODE_DOCKER_BIND_ADDRESS=


# --[ SKILLS ]-----------------------------------------------------------------

# Git repository with your agent skills. The server keeps one copy, pulls it
# regularly, and makes it available to every agent in every project.
# A private repository needs your SSH key in import/ssh/ (see README).
# Remove this line if you don't use a skills repository.
T3CODE_DOCKER_SKILLS_REPO=git@github.com:neurekadev/agent-skills.git

# Folder inside that repository that holds the skills.
# Default: skills
# T3CODE_DOCKER_SKILLS_PATH=skills

# How often to pull new skills, in seconds (30 or more). 300 is 5 minutes.
# Running agents are not interrupted; new skills apply to new sessions.
# Default: 300
# T3CODE_DOCKER_SKILLS_INTERVAL=300


# --[ OPTIONAL ]---------------------------------------------------------------

# Time zone for logs and anything agents run, e.g. Europe/London or
# America/New_York.
# Default: UTC
# TZ=UTC

# T3 Code release train for the very first install: stable or nightly.
# Nightly needs the beta mobile app. Later updates stay on the same train.
# Default: stable
# T3CODE_CHANNEL=stable

# Troubleshooting only. If the server won't start after a T3 Code update, set
# this to false to run T3 Code directly. "Update server" in the app then stops
# working until you set it back to true.
# Default: true
# T3CODE_DOCKER_SERVICE_LAUNCHER=true
