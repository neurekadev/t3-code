#!/usr/bin/env bash
# Prepares the container on every start, then runs T3 Code's service launcher:
#   1. Checks and applies the import folder: SSH keys, git config, T3 settings.
#      Misplaced or invalid imports are logged and skipped.
#   2. Starts an SSH agent holding the imported keys (clone, push, signing, ssh).
#   3. Installs T3 Code, Claude Code, Codex and OpenCode if they are missing.
#      Installed tools are never updated here; updates come from the T3 Code app.
#   4. Keeps the skills repository in sync in the background, if configured.
set -euo pipefail

IMPORT_DIR=/app/import
# Both must match the include paths in the Dockerfile's /etc/gitconfig.
GIT_IMPORT_INCLUDE=/run/t3code/gitconfig
GIT_GITLAB_INCLUDE=/run/t3code/gitlab.gitconfig
T3_USERDATA="$T3CODE_HOME/userdata"
T3_STATE_FILE="$T3CODE_HOME/runtime/service-state.json"
T3_VERSIONS_DIR="$T3CODE_HOME/runtime/versions"
T3_CLI_LINK="$HOME/.local/bin/t3"
# Must match SERVICE_LAUNCHER_PROTOCOL in apps/server/src/cloud/serviceProtocol.ts.
T3_LAUNCHER_PROTOCOL=3
SKILLS_CLONE=/app/data/skills
GH_INSTALLS_DIR=$MISE_DATA_DIR/installs/gh

log() {
  printf '[t3code] %s\n' "$*" >&2
}

is_private_key() {
  grep -q -- '-----BEGIN .*PRIVATE KEY-----' "$1" 2>/dev/null
}

# Copies import/ssh into ~/.ssh with the permissions OpenSSH requires. Windows
# line endings are stripped. The imported config is prefixed so ssh always uses
# this container's agent, overriding Windows-only IdentityAgent pipes. The
# repository's *.example files are templates, not imports.
import_ssh() {
  local source=$IMPORT_DIR/ssh file name mode copied=()
  if [[ ! -e $source ]]; then
    log "No import/ssh folder; no SSH files imported."
    return 0
  elif [[ ! -d $source ]]; then
    log "Ignoring import/ssh: it must be a folder."
    return 0
  fi
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"

  for file in "$source"/*; do
    name=$(basename "$file")
    [[ -e $file && $name != *.example ]] || continue
    if [[ ! -f $file ]]; then
      log "Ignoring import/ssh/$name: it must be a file, not a folder."
      continue
    fi
    copied+=("$name")
    if [[ $name == config ]]; then
      {
        printf '# Generated from import/ssh/config on container start; edit that file instead.\n'
        printf 'Host *\n    IdentityAgent SSH_AUTH_SOCK\n\n'
        tr -d '\r' <"$file"
      } >"$HOME/.ssh/config"
      chmod 600 "$HOME/.ssh/config"
      continue
    fi
    mode=600
    [[ $name == *.pub || $name == known_hosts* ]] && mode=644
    tr -d '\r' <"$file" >"$HOME/.ssh/$name"
    chmod "$mode" "$HOME/.ssh/$name"
  done
  if ((${#copied[@]})); then
    log "Imported SSH files from import/ssh: ${copied[*]}."
  else
    log "import/ssh has no files; no SSH files imported."
  fi
}

# Loads every private key in ~/.ssh, including keys imported on earlier starts
# that are no longer in import/ssh, so the log names each one.
start_ssh_agent() {
  local key loaded=()
  mkdir -p "$(dirname "$SSH_AUTH_SOCK")"
  rm -f "$SSH_AUTH_SOCK"
  ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null

  for key in "$HOME"/.ssh/*; do
    if [[ ! -f $key ]] || ! is_private_key "$key"; then
      continue
    fi
    if ssh-add -q "$key" </dev/null 2>/dev/null; then
      loaded+=("$(basename "$key")")
    else
      log "Could not load SSH key $(basename "$key"); keys with a passphrase are not supported."
    fi
  done
  if ((${#loaded[@]})); then
    log "SSH agent ready with ${#loaded[@]} key(s) from ~/.ssh: ${loaded[*]}."
  else
    log "SSH agent ready with no keys."
  fi
}

# Prints why git rejects a config file, or nothing if git accepts it. The file
# is loaded on its own, with the includes it pulls in, and git checks its core
# values too, so `autocrlf = maybe` fails here instead of in every git command.
git_config_error() {
  local error
  if [[ -d $1 ]]; then
    printf '%s is a folder, not a file\n' "$1"
  elif ! error=$(cd / && GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=$1 git var -l 2>&1 >/dev/null); then
    error=${error##*$'\n'}
    error=${error#fatal: }
    printf '%s\n' "${error:-git could not load $1}"
  fi
}

# /etc/gitconfig (built into the image) includes GIT_IMPORT_INCLUDE and replaces
# Windows-only programs. That file includes import/gitconfig by its real path
# (so its relative includes resolve) only if git accepts it at start, so a
# broken import cannot make every git command fail. Later edits are read live
# without a check. Warn about any other Windows paths it contains.
import_git_config() {
  local imported=$IMPORT_DIR/gitconfig error entry target
  # A drive letter must not follow another letter, so URLs (https://) don't match.
  local windows_path='(^|[^a-z0-9])[a-z]:[\\/]|\.exe'
  rm -f "$GIT_IMPORT_INCLUDE"
  if [[ ! -e $imported ]]; then
    log "No import/gitconfig; no git config imported."
    return 0
  elif [[ ! -f $imported ]]; then
    log "Ignoring import/gitconfig: it must be your .gitconfig file itself, not a folder."
    return 0
  fi
  error=$(git_config_error "$imported")
  # includeIf files load only in matching repositories, so check each directly.
  # Entries are "key\nvalue", NUL-separated: conditions may contain spaces.
  while [[ -z $error ]] && IFS= read -r -d '' entry; do
    if [[ $entry != *$'\n'* ]]; then
      error="$entry has no value"
      break
    fi
    target=${entry#*$'\n'}
    case $target in
      \~/*) target=$HOME/${target#\~/} ;;
      /*) ;;
      *) target=$(dirname "$imported")/$target ;;
    esac
    if [[ -e $target ]]; then
      error=$(git_config_error "$target")
    fi
  done < <(GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git config -z --includes --file "$imported" --get-regexp '^includeif\..*\.path$' 2>/dev/null)
  if [[ -n $error ]]; then
    log "Ignoring import/gitconfig: $error"
    return 0
  fi
  mkdir -p "$(dirname "$GIT_IMPORT_INCLUDE")"
  printf '[include]\n\tpath = %s\n' "$imported" >"$GIT_IMPORT_INCLUDE"
  log "Imported git config from import/gitconfig."
  if grep -qiE "$windows_path" "$imported"; then
    log "import/gitconfig has Windows paths in:" \
      "$(grep -iE "$windows_path" "$imported" | sed -E 's/^\s*([^= ]+).*/\1/' | tr '\n' ' ')"
    log "core.sshCommand and gpg.ssh.program are replaced automatically; fix any others."
  fi
}

# Older images let `gh auth login` and `gh auth setup-git` write gh's versioned
# install path into ~/.gitconfig as the GitHub credential helper. An image with
# a newer gh removes that path, so point such entries at the stable link.
repair_gh_credential_helper() {
  local host key
  for host in https://github.com https://gist.github.com; do
    key=credential.$host.helper
    if [[ $(git config --global --get-all "$key" 2>/dev/null) == *"$GH_INSTALLS_DIR/"* ]]; then
      git config --global --replace-all "$key" "!/usr/local/bin/gh auth git-credential" "$GH_INSTALLS_DIR/"
      log "Pointed the gh credential helper for $host in ~/.gitconfig at /usr/local/bin/gh."
    fi
  done
}

# /etc/gitconfig signs in to https://gitlab.com through glab, which reads
# GITLAB_TOKEN. Give a self-managed GITLAB_HOST the same helper. glab accepts
# the host with or without a scheme, so default to https:// like glab does.
configure_gitlab_host() {
  local url=${GITLAB_HOST:-}
  rm -f "$GIT_GITLAB_INCLUDE"
  url=${url%/}
  if [[ -z $url ]]; then
    return 0
  fi
  [[ $url == http://* || $url == https://* ]] || url=https://$url
  if [[ ! $url =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]]; then
    log "Ignoring GITLAB_HOST: expected a host name like gitlab.example.com."
    return 0
  elif [[ $url == https://gitlab.com ]]; then
    return 0
  fi
  mkdir -p "$(dirname "$GIT_GITLAB_INCLUDE")"
  printf '[credential "%s"]\n\thelper = !/usr/local/bin/glab auth git-credential\n' "$url" >"$GIT_GITLAB_INCLUDE"
  log "Git signs in to $url through glab."
}

# Copies import/t3 into T3 Code's userdata. Each file is applied again only when
# its imported copy changes, so later edits made in the app are kept.
import_t3_settings() {
  local source=$IMPORT_DIR/t3 file relative target marker checksum found=0
  if [[ ! -e $source ]]; then
    log "No import/t3 folder; no T3 Code settings imported."
    return 0
  elif [[ ! -d $source ]]; then
    log "Ignoring import/t3: it must be a folder."
    return 0
  fi
  for file in settings.json keybindings.json; do
    if [[ -d $source/$file ]]; then
      log "Ignoring import/t3/$file: it must be a file, not a folder."
    fi
  done
  while IFS= read -r -d '' file; do
    relative=${file#"$source"/}
    if [[ $relative != settings.json && $relative != keybindings.json && $relative != themes/*.json ]]; then
      log "Ignoring import/t3/$relative: expected settings.json, keybindings.json or themes/*.json."
      continue
    fi
    found=$((found + 1))
    target=$T3_USERDATA/$relative
    marker=$T3_USERDATA/.imported/$relative.sha256
    checksum=$(sha256sum "$file" | cut -d' ' -f1)
    if [[ -f $marker && $(cat "$marker") == "$checksum" ]]; then
      log "Kept T3 Code $relative: import/t3 copy unchanged since it was last applied."
      continue
    fi
    mkdir -p "$(dirname "$target")" "$(dirname "$marker")"
    cp "$file" "$target"
    printf '%s\n' "$checksum" >"$marker"
    log "Imported T3 Code $relative."
  done < <(find "$source" -type f ! -name '.*' -print0)
  if ((found == 0)); then
    log "import/t3 has no T3 Code settings; none imported."
  fi
}

# Prints the version the `t3` symlink points at; empty before the first install.
staged_t3_version() {
  local target
  if target=$(readlink "$T3_CLI_LINK" 2>/dev/null); then
    basename "$(dirname "$target")"
  fi
}

# Prints the version the service launcher runs; empty before the first start.
active_t3_version() {
  if [[ -f $T3_STATE_FILE ]]; then
    jq -r '.activeVersion // empty' "$T3_STATE_FILE" 2>/dev/null || true
  fi
}

runtime_is_complete() {
  [[ -n $1 && -f $T3_VERSIONS_DIR/$1/.install-complete ]]
}

install_missing_tools() {
  if ! runtime_is_complete "$(staged_t3_version)"; then
    log "Installing T3 Code ($T3CODE_CHANNEL)..."
    curl -fsSL https://t3.codes/install.sh | sh
  fi
  if ! command -v claude >/dev/null; then
    log "Installing Claude Code..."
    { curl -fsSL https://claude.ai/install.sh | bash; } || log "Claude Code failed to install; retrying on the next start."
  fi
  if ! command -v codex >/dev/null; then
    log "Installing Codex..."
    npm install -g @openai/codex || log "Codex failed to install; retrying on the next start."
  fi
  if ! command -v opencode >/dev/null; then
    log "Installing OpenCode..."
    npm install -g @opencode/cli || log "OpenCode failed to install; retrying on the next start."
  fi
}

# On first start, tells the service launcher which T3 Code version to run. After
# that the launcher owns this file: in-app updates switch versions and roll back.
activate_t3() {
  if ! runtime_is_complete "$(active_t3_version)"; then
    mkdir -p "$(dirname "$T3_STATE_FILE")"
    printf '{"protocol":%d,"activeVersion":"%s"}\n' "$T3_LAUNCHER_PROTOCOL" "$(staged_t3_version)" >"$T3_STATE_FILE"
  fi
  # Keep the `t3` command on the version the server runs.
  ln -sfn "$T3_VERSIONS_DIR/$(active_t3_version)/t3" "$T3_CLI_LINK"
}

# Clones or fast-forwards the skills repository. Never discards local changes:
# a clone that cannot fast-forward is reported and left alone.
sync_skills() {
  if [[ ! -d $SKILLS_CLONE/.git ]]; then
    git clone --quiet "$T3CODE_DOCKER_SKILLS_REPO" "$SKILLS_CLONE" || return 1
    log "Cloned skills from $T3CODE_DOCKER_SKILLS_REPO."
    return 0
  fi
  git -C "$SKILLS_CLONE" remote set-url origin "$T3CODE_DOCKER_SKILLS_REPO"
  git -C "$SKILLS_CLONE" pull --quiet --ff-only
}

# Points ~/.claude/skills (Claude Code, OpenCode) and ~/.agents/skills (Codex,
# OpenCode) at the skills folder. A real directory already there is left alone.
link_skills() {
  local target=$SKILLS_CLONE/$T3CODE_DOCKER_SKILLS_PATH link
  for link in "$HOME/.claude/skills" "$HOME/.agents/skills"; do
    if [[ -e $link && ! -L $link ]]; then
      log "Not linking $link: it is a real directory. Move it aside to use the skills repository."
      continue
    fi
    mkdir -p "$(dirname "$link")"
    ln -sfn "$target" "$link"
  done
}

start_skills_sync() {
  local interval=$T3CODE_DOCKER_SKILLS_INTERVAL
  [[ -n ${T3CODE_DOCKER_SKILLS_REPO:-} ]] || return 0
  if [[ ! $interval =~ ^[0-9]+$ || $interval -lt 30 ]]; then
    log "T3CODE_DOCKER_SKILLS_INTERVAL must be a number of seconds, 30 or more; using 60."
    interval=60
  fi

  link_skills
  log "Syncing skills from $T3CODE_DOCKER_SKILLS_REPO every ${interval}s."
  # Runs in the background so a slow or unreachable remote never delays the
  # server. The clone persists in the data volume, so only the first start waits.
  (
    while :; do
      sync_skills || log "Skills sync failed; retrying in ${interval}s. Check the SSH key and T3CODE_DOCKER_SKILLS_REPO."
      sleep "$interval"
    done
  ) &
}

mkdir -p "$HOME/.local/bin" "$T3_USERDATA"
import_ssh
start_ssh_agent
import_git_config
repair_gh_credential_helper
configure_gitlab_host
import_t3_settings
install_missing_tools
activate_t3
start_skills_sync
cd "$HOME"

runtime="$T3_VERSIONS_DIR/$(active_t3_version)/t3"
log "Starting T3 Code $(active_t3_version)."
# T3 Code prints its startup link and QR code with the container's private IP;
# t3code-links corrects both on their way to the logs. T3 Code still replaces
# this shell below, so tini keeps signalling it directly.
exec 2> >(/app/bin/t3code-links >&2)
exec > >(/app/bin/t3code-links)
if [[ $T3CODE_DOCKER_SERVICE_LAUNCHER == true ]]; then
  exec "$runtime" __service-launcher
fi
exec "$runtime" serve
