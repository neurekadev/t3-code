#!/usr/bin/env bash
# Prints a new pairing link and QR code that clients can reach. `t3 pair` builds
# its link from the container's private Docker IP, so its output goes through
# t3code-links, as the server's startup link does. --host sets the address when
# the bind address is 0.0.0.0. Tailscale links (https) already point at the
# tailnet and pass through.
# Usage: t3code-pair [--host <server IP or hostname>] [t3 pair options]
set -euo pipefail

links=/app/bin/t3code-links
host=()
args=()
while (($#)); do
  case $1 in
    --host) host=(--host "${2:?--host needs the server IP or hostname}"); shift 2 ;;
    --host=*) host=(--host "${1#--host=}"); shift ;;
    -h | --help) exec t3 pair --help ;;
    *) args+=("$1"); shift ;;
  esac
done

# Check before minting a token, unless Tailscale (which needs no host) is asked for.
tailscale=false
for arg in "${args[@]}"; do
  [[ $arg == --tailscale || $arg == --tailscale=* ]] && tailscale=true
done
$tailscale || "$links" --check "${host[@]}" >/dev/null

# t3 prints its errors on stdout, so pass captured output on when it fails.
output=$(t3 pair "${args[@]}") || {
  status=$?
  printf '%s\n' "$output" >&2
  exit "$status"
}
url=$(sed -n 's/^Pairing URL: //p' <<<"$output")
if [[ -z $url ]]; then
  printf '%s\n' "$output" >&2
  exit 1
elif [[ $url != http://* ]]; then
  printf '%s\n' "$output"
  exit 0
fi
"$links" --check "${host[@]}" >/dev/null
"$links" "${host[@]}" <<<"$output"
