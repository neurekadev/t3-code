#!/usr/bin/env bash
# Prints a pairing link and QR code that clients can reach. `t3 pair` builds
# its link from the container's first network interface, a private Docker IP,
# so this swaps in T3CODE_DOCKER_BIND_ADDRESS, or --host when that is 0.0.0.0.
# Usage: t3code-pair [--host <server IP or hostname>] [t3 pair options]
set -euo pipefail

host=${T3CODE_DOCKER_BIND_ADDRESS:-}
if [[ ${1:-} == --host ]]; then
  host=${2:?--host needs the server IP or hostname}
  shift 2
fi

# Tailscale Serve links already point at the tailnet name.
for arg in "$@"; do
  [[ $arg == --tailscale ]] && exec t3 pair "$@"
done

if [[ -z $host || $host == 0.0.0.0 ]]; then
  echo "T3CODE_DOCKER_BIND_ADDRESS is 0.0.0.0, so the server's address is unknown here." >&2
  echo "Pass it in: t3code-pair --host <server IP or hostname>" >&2
  exit 1
fi
[[ $host == *:* && $host != \[* ]] && host="[$host]"

output=$(t3 pair "$@")
details=$(sed -n '/^Pairing URL: /,$p' <<<"$output")
if [[ -z $details ]]; then
  printf '%s\n' "$output"
  exit 1
fi
# compose.yaml publishes T3 Code on the same port it listens on inside.
container_origin=$(sed -nE 's#^Pairing URL: (https?://[^/]+).*#\1#p' <<<"$details")
details=${details//"$container_origin"/"http://$host:${container_origin##*:}"}

printf '\n'
qrencode -t ANSIUTF8 -m 2 "$(sed -n 's/^Pairing URL: //p' <<<"$details")"
printf '\n%s\n' "$details"
